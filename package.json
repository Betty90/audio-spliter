{
  "name": "audioslicer-ai",
  "private": true,
  "version": "1.2.2",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "npm run electron:dev",
    "web:dev": "concurrently \"python backend/server.py || python3 backend/server.py\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build && concurrently \"vite\" \"electron electron/dist/main.js\"",
    "electron:pack": "npm run build && npm run electron:build && electron-builder",
    "electron:pack:mac": "npm run build && npm run electron:build && electron-builder --mac",
    "electron:pack:win": "npm run build && npm run electron:build && electron-builder --win",
    "electron:pack:linux": "npm run build && npm run electron:build && electron-builder --linux",
    "electron:preview": "npm run build && npm run electron:build && electron electron/dist/main.js",
    "build:all": "node scripts/build.js --clean --pack",
    "build:python": "node scripts/build.js --python",
    "dist": "npm run build:all",
    "release": "node scripts/build.js --clean --pack --publish",
    "postinstall": "electron-builder install-app-deps"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Betty90/audio-spliter.git"
  },
  "author": "AudioSlicer AI Team",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.574.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "wavesurfer.js": "^7.12.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^35.0.3",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
